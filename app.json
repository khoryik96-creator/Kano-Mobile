{
  "expo": {
    "name": "Kano",
    "slug": "kano-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "kano",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kano.mobile"
    },
    "android": {
      "package": "com.kano.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "./plugins/withKotlinVersion"
    ]
  }
}
